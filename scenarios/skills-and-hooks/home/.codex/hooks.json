{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "echo MARKER home/.codex/hooks.json session-start"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "echo MARKER home/.codex/hooks.json after-edit"
          }
        ]
      }
    ]
  }
}
