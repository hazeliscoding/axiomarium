<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Axiomarium.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Tomlyn" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <!-- The schema files in the repo are the single source of truth; the binary carries a copy. -->
    <EmbeddedResource Include="..\..\schemas\*.schema.json" LogicalName="schemas/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\registry\*.yaml" LogicalName="registry/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Axiomarium.Tests" />
  </ItemGroup>
</Project>
